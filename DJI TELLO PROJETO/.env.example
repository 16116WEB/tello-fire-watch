# Copie para ".env" e ajuste se quiser. Nenhuma variavel e obrigatoria;
# valores padrao razoaveis ja estao em config.py.

# Servidor
TELLO_SECRET_KEY=troque-isto-se-for-expor-na-rede
PORT=5000
FLASK_DEBUG=0

# Seguranca de voo
TELLO_COMMAND_TIMEOUT=8
TELLO_BATTERY_WARNING_PCT=20
TELLO_BATTERY_CRITICAL_PCT=10

# Limite de arquivos em media/
TELLO_MAX_PHOTOS=300
TELLO_MAX_VIDEOS=50
